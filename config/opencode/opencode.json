{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push --force*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push -f *",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "ask-matt",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "edit-article",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "grill-me",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "grill-with-docs",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "handoff",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "implement",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "implement-spec",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "improve-codebase-architecture",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "retro",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "setup-matt-pocock-skills",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "teach",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "to-questionnaire",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "to-spec",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "to-tickets",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "triage",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "wait-what",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "wayfinder",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "writing-for-agents",
      "effect": "ask"
    },
    {
      "action": "codegraph_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/workspace/**",
      "effect": "allow"
    }
  ],
  "experimental": {
    "todo": true
  },
  "formatter": {
    "clang-format": {
      "command": [
        "sh",
        "-c",
        "clang-format --style=file:\"$HOME/.config/nvim/.clang-format\" -i \"$FILE\""
      ],
      "extensions": [
        "c",
        "cpp",
        "h",
        "hpp",
        "cc",
        "cxx"
      ]
    }
  }
}
