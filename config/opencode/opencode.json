{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  },
  "lsp": true,
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "git push --force*": "ask",
      "git push -f *": "ask"
    },
    "skill": {
      "*": "allow",
      "ask-matt": "ask",
      "edit-article": "ask",
      "grill-me": "ask",
      "grill-with-docs": "ask",
      "handoff": "ask",
      "implement": "ask",
      "improve-codebase-architecture": "ask",
      "setup-matt-pocock-skills": "ask",
      "teach": "ask",
      "to-spec": "ask",
      "to-tickets": "ask",
      "triage": "ask",
      "wayfinder": "ask",
      "writing-great-skills": "ask"
    },
    "codegraph_*": "allow",
    "external_directory": {
      "~/workspace/**": "allow"
    }
  },
  "plugin": ["@franlol/opencode-md-table-formatter@latest"],
  "formatter": {
    "clang-format": {
      "command": [
        "sh",
        "-c",
        "clang-format --style=file:\"$HOME/.config/nvim/.clang-format\" -i \"$FILE\""
      ],
      "extensions": ["c", "cpp", "h", "hpp", "cc", "cxx"]
    }
  }
}
